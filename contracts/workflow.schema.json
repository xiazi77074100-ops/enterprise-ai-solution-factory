{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:easf:contract:workflow:1",
  "title": "SolutionWorkflow v1",
  "description": "Typed DAG of version-pinned capability nodes. Cycles are rejected by the Composer. Each edge maps output paths of the source node to input fields of the target node; the Composer checks type compatibility against the pinned contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "version", "name", "inputs", "nodes", "edges", "outputs", "budget", "requires_human_approval"],
  "properties": {
    "schema_version": { "const": "1" },
    "workflow_id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 1000 },
    "inputs": {
      "description": "Run inputs and the node fields they feed.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "to"],
        "properties": {
          "name": { "$ref": "#/$defs/fieldName" },
          "type": { "enum": ["document_ref", "string", "integer", "boolean"] },
          "to": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/nodeField" }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "capability_id", "capability_version", "config"],
        "properties": {
          "node_id": { "$ref": "#/$defs/nodeId" },
          "capability_id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "capability_version": {
            "description": "Exact pinned version. Ranges are not allowed.",
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "config": {
            "description": "Validated against the pinned capability's configuration_schema.",
            "type": "object"
          },
          "timeout_ms": {
            "description": "Optional override; must be <= the capability's timeout_ms.",
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "mapping"],
        "properties": {
          "from": { "$ref": "#/$defs/nodeId" },
          "to": { "$ref": "#/$defs/nodeId" },
          "mapping": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from_path", "to_field"],
              "properties": {
                "from_path": { "$ref": "#/$defs/jsonPointer" },
                "to_field": { "$ref": "#/$defs/fieldName" }
              }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "from_node", "from_path"],
        "properties": {
          "name": { "$ref": "#/$defs/fieldName" },
          "from_node": { "$ref": "#/$defs/nodeId" },
          "from_path": { "$ref": "#/$defs/jsonPointer" }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_ms", "max_llm_tokens", "max_cost_jpy"],
      "properties": {
        "max_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
        "max_llm_tokens": { "type": "integer", "minimum": 0, "maximum": 2000000 },
        "max_cost_jpy": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "requires_human_approval": {
      "description": "The solution must be approved (by someone other than its author) before runs can start.",
      "type": "boolean"
    }
  },
  "$defs": {
    "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "fieldName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "jsonPointer": { "type": "string", "maxLength": 256, "pattern": "^(/([^/~]|~[01])*)*$" },
    "nodeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "field"],
      "properties": {
        "node_id": { "$ref": "#/$defs/nodeId" },
        "field": { "$ref": "#/$defs/fieldName" }
      }
    }
  }
}
