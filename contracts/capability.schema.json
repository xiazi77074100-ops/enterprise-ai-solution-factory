{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:easf:contract:capability:1",
  "title": "CapabilityContract v1",
  "description": "Immutable capability version. Embedded schemas must not contain external $ref (enforced by the Catalog validator in code). implementation.ref is a key in the server-side registry allowlist, never an importable path. content_sha256 is the SHA-256 of the RFC 8785 (JCS) canonical JSON of the contract; identical canonical content re-registers idempotently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "version",
    "kind",
    "name",
    "description",
    "input_schema",
    "output_schema",
    "configuration_schema",
    "implementation",
    "tags",
    "provenance",
    "timeout_ms",
    "retry",
    "side_effects"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "capability_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "kind": {
      "enum": [
        "local",
        "rest",
        "mcp_tool",
        "llm"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "input_schema": {
      "$ref": "#/$defs/embeddedSchema"
    },
    "output_schema": {
      "$ref": "#/$defs/embeddedSchema"
    },
    "configuration_schema": {
      "$ref": "#/$defs/embeddedSchema"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "description": "Registry key resolved by the adapter for this kind (local function key, REST connector name, MCP server+tool key, or LLM task key).",
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.:-]*$"
        }
      }
    },
    "tags": {
      "description": "Discovery only. The generic engine must never branch on tags.",
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "license",
        "author"
      ],
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "maxLength": 64
        },
        "author": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "evaluation_profile": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "idempotent"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "idempotent": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "idempotent": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "max_attempts": {
            "const": 0
          }
        }
      }
    },
    "side_effects": {
      "description": "Effects outside EASF (sending, external writes, payments, filings). Writing to EASF's own storage (e.g. export files) is not a side effect. POC executes only side-effect-free capabilities.",
      "const": false
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "embeddedSchema": {
      "description": "A JSON Schema 2020-12 object schema. Must be closed (additionalProperties: false) at the top level.",
      "type": "object",
      "required": [
        "type",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "$id": false,
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        }
      }
    }
  }
}
