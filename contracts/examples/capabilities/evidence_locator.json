{
  "schema_version": "1",
  "capability_id": "document.evidence_locator",
  "version": "1.0.0",
  "kind": "mcp_tool",
  "name": "Evidence Locator",
  "description": "抽出値の根拠を元の文書の中で探し、位置とハッシュを返す。見つからなければ unverified。",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "document_id",
      "pages",
      "fields"
    ],
    "properties": {
      "document_id": {
        "type": "string",
        "format": "uuid"
      },
      "pages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page",
            "text",
            "extraction_method"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "maxLength": 50000
            },
            "extraction_method": {
              "enum": [
                "text_layer",
                "ocr_tesseract",
                "ocr_llm"
              ]
            }
          }
        }
      },
      "fields": {
        "type": "object",
        "maxProperties": 100,
        "description": "Extracted values keyed by field_spec name; null when not found."
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "evidence"
    ],
    "properties": {
      "evidence": {
        "type": "object",
        "maxProperties": 100,
        "additionalProperties": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "page",
              "start",
              "end",
              "text_sha256",
              "status"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "format": "uuid"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "verified",
                  "unverified"
                ]
              }
            }
          }
        }
      }
    }
  },
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "match"
    ],
    "properties": {
      "match": {
        "enum": [
          "exact",
          "normalized"
        ]
      }
    }
  },
  "implementation": {
    "ref": "easf_local_mcp:locate_evidence"
  },
  "tags": [
    "document"
  ],
  "provenance": {
    "source": "independent_poc",
    "license": "internal_poc",
    "author": "easf"
  },
  "evaluation_profile": "document-v1",
  "timeout_ms": 30000,
  "retry": {
    "max_attempts": 2,
    "idempotent": true
  },
  "side_effects": false
}