{
  "schema_version": "1",
  "capability_id": "document.rule_extractor",
  "version": "1.1.0",
  "kind": "local",
  "name": "Rule-based Extractor",
  "description": "見出し（labels）の後ろの値、前後の文言（between）に挟まれた値、短い見出しの行（heading）、文言による真偽（true_if・false_if）を、LLM を使わずに拾う（D-015、P4-03）。値が 1 つなら found、食い違い・あいまいの文言（uncertain_if）は uncertain、無ければ missing。1.0.0 の設定はそのまま動く。",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "document_id",
      "pages"
    ],
    "properties": {
      "document_id": {
        "type": "string",
        "format": "uuid"
      },
      "pages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page",
            "text",
            "extraction_method"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "maxLength": 50000
            },
            "extraction_method": {
              "enum": [
                "text_layer",
                "ocr_tesseract",
                "ocr_llm"
              ]
            }
          }
        }
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "fields",
      "field_status"
    ],
    "properties": {
      "fields": {
        "type": "object",
        "maxProperties": 100,
        "description": "Extracted values keyed by field_spec name; null when not found."
      },
      "field_status": {
        "type": "object",
        "maxProperties": 100,
        "additionalProperties": {
          "enum": [
            "found",
            "missing",
            "uncertain"
          ]
        }
      }
    }
  },
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "field_spec"
    ],
    "properties": {
      "field_spec": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type",
            "label_ja",
            "critical"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "type": {
              "enum": [
                "string",
                "integer",
                "decimal",
                "date",
                "boolean",
                "array"
              ]
            },
            "label_ja": {
              "type": "string",
              "maxLength": 50
            },
            "critical": {
              "type": "boolean"
            },
            "labels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              }
            },
            "between": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "before",
                  "after"
                ],
                "properties": {
                  "before": {
                    "type": "string",
                    "maxLength": 50
                  },
                  "after": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  }
                }
              }
            },
            "heading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "true_if": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              }
            },
            "false_if": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              }
            },
            "uncertain_if": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              }
            }
          }
        }
      }
    }
  },
  "implementation": {
    "ref": "rule_based_extractor.v1"
  },
  "tags": [
    "document"
  ],
  "provenance": {
    "source": "independent_poc",
    "license": "internal_poc",
    "author": "easf"
  },
  "evaluation_profile": "document-v1",
  "timeout_ms": 30000,
  "retry": {
    "max_attempts": 2,
    "idempotent": true
  },
  "side_effects": false
}
