{
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "document_id",
      "pages",
      "fields",
      "match"
    ],
    "properties": {
      "document_id": {
        "type": "string",
        "format": "uuid"
      },
      "pages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page",
            "text",
            "extraction_method"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "maxLength": 50000
            },
            "extraction_method": {
              "enum": [
                "text_layer",
                "ocr_tesseract",
                "ocr_llm"
              ]
            }
          }
        }
      },
      "fields": {
        "type": "object",
        "maxProperties": 100,
        "description": "Extracted values keyed by field_spec name; null when not found."
      },
      "match": {
        "enum": [
          "exact",
          "normalized"
        ]
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "evidence"
    ],
    "properties": {
      "evidence": {
        "type": "object",
        "maxProperties": 100,
        "additionalProperties": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "page",
              "start",
              "end",
              "text_sha256",
              "status"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "format": "uuid"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "verified",
                  "unverified"
                ]
              }
            }
          }
        }
      }
    }
  }
}
