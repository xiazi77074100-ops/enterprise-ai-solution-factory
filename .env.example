# Copy to .env (never commit .env). Use long random values for passwords.
EASF_ENV=dev
EASF_DB_PORT=55432
EASF_OWNER_DB_PASSWORD=CHANGE_ME
EASF_APP_DB_PASSWORD=CHANGE_ME

# Application (DML only) and migration (owner) connections
EASF_DATABASE_URL=postgresql+psycopg://easf_app:CHANGE_ME@127.0.0.1:55432/easf
EASF_MIGRATION_DATABASE_URL=postgresql+psycopg://easf_owner:CHANGE_ME@127.0.0.1:55432/easf
EASF_SITE_ORIGIN=http://localhost:5173
EASF_COOKIE_SECURE=false

# LLM (ADR-002). Real providers stay disabled until approved (D-004 / D-015).
EASF_LLM_GEMINI_API_KEY=
EASF_LLM_ANTHROPIC_API_KEY=
EASF_LLM_OPENAI_API_KEY=
EASF_LLM_AZURE_OPENAI_API_KEY=
