{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/easf/workflow.schema.json",
  "title": "SolutionWorkflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "version",
    "nodes",
    "edges"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "capability_id",
          "capability_version",
          "config"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "capability_id": {
            "type": "string"
          },
          "capability_version": {
            "type": "string"
          },
          "config": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "requires_human_approval": {
      "type": "boolean"
    }
  }
}
