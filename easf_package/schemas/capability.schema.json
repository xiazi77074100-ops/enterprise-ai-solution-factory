{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/easf/capability.schema.json",
  "title": "CapabilityContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "version",
    "kind",
    "name",
    "description",
    "input_schema",
    "output_schema",
    "implementation",
    "applicability",
    "provenance"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "enum": [
        "local",
        "rest",
        "mcp_tool",
        "mcp_resource",
        "mcp_prompt"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "configuration_schema": {
      "type": "object"
    },
    "implementation": {
      "type": "object",
      "required": [
        "adapter",
        "reference"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "license"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evaluation_profile": {
      "type": "string"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "side_effects": {
      "type": "boolean",
      "default": false
    }
  }
}
